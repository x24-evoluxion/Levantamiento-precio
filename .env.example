# Copia este archivo como .env.local y pon tus valores ahí.
# NUNCA subas .env.local a git.

# Dirección del proyecto de Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=

# Llave pública "publishable" (antes llamada "anon") (NO la service_role / secret)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# SOLO SERVIDOR (scripts locales en scripts/), NUNCA con NEXT_PUBLIC_.
# Nunca en el navegador ni en Vercel. Se lee con: node --env-file=.env.local
# ---------------------------------------------------------------------------
# Llave secreta de Supabase (Project Settings → API Keys → Secret keys, empieza
# con sb_secret_). Se salta RLS: puede leer y escribir todo.
SUPABASE_SECRET_KEY=
